# --- 镜像配置 ---
IMAGE_ACCEL=fusionregistry:5000/wings-accel:26.0.2
# 必须是 -license 后缀 tag(含 License 门禁,由 build/build.sh --enable-license 产出)
IMAGE_CONTROL=fusionregistry:5000/wings-control:26.0.2-license
IMAGE_ENGINE=ascendai/vllm-ascend:v0.21.0rc1
ENGINE=vllm-ascend
# 引擎版本: 选择 wings-infer-pro 配置资产树(config/engines/vllm-ascend/<版本>/)。
# 注意: 框架按 vX.Y.Z(可含 rc 渠道)匹配配置目录, 引擎镜像 tag 可比它更详细
# (如 v0.18.0rc1 → 配置目录 v0.18.0); 未精确命中时会回退 latest 并告警,
# 因此这里填配置树中实际存在的版本目录。
ENGINE_VERSION=v0.18.0

# --- 模型配置 ---
MODEL_NAME=Qwen3-32B
MODEL_PATH=/data/models/Qwen3-32B-W8A8

# --- 硬件族配置 ---
# 定位 config/engines/vllm-ascend/<ENGINE_VERSION>/<HARDWARE_FAMILY>/models/
# 可选: ascend-a2 / ascend-a3 / ascend910b-x86_64 (以镜像内实际目录为准)
HARDWARE_FAMILY=ascend-a2

# --- 端口配置 ---
ENGINE_PORT=17001
CONTROL_PORT=18001
HEALTH_PORT=19001
MONITOR_PROXY_PORT=19101

# --- 服务命名后缀 (影响容器名) ---
SERVICE_SUFFIX=qwen

# --- vLLM 引擎参数 ---
QUANTIZATION=ascend
GPU_MEMORY_UTILIZATION=0.9
SHM_SIZE=16g
INPUT_LENGTH=16384
OUTPUT_LENGTH=16384
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=
KV_CACHE_DTYPE=auto
BLOCK_SIZE=128
DTYPE=auto
TRUST_REMOTE_CODE=true

# --- 设备挂载  ---
DEVICE_COUNT=2
XPU_VISIBLE_DEVICES=10,12

# --- 特性开关 ---
ENABLE_REASON_PROXY=true
ENABLE_SPECULATIVE_DECODE=true
ENABLE_ACCEL=false
ENABLE_SPARSE=false
