# --- 镜像配置 ---
IMAGE_ACCEL=fusionregistry:5000/wings-accel:26.0.2
# 必须是 -license 后缀 tag(含 License 门禁,由 build/build.sh --enable-license 产出)
IMAGE_CONTROL=fusionregistry:5000/wings-control:26.0.2-license
IMAGE_ENGINE=ascendai/vllm-ascend:v0.21.0rc1
ENGINE=vllm-ascend
# 引擎版本: 选择 wings-infer-pro 配置资产树(config/engines/vllm-ascend/<版本>/)。
# 注意: 框架按 vX.Y.Z(可含 rc 渠道)匹配配置目录, 引擎镜像 tag 可比它更详细
# (如 v0.18.0rc1 → 配置目录 v0.18.0); 未精确命中时会回退 latest 并告警,
# 因此这里填配置树中实际存在的版本目录。
ENGINE_VERSION=v0.21.0rc

# --- 模型配置 ---
MODEL_NAME=Qwen3-32B
MODEL_PATH=/data/models/Qwen3-32B-W8A8

# --- 硬件族配置 ---
# 定位 config/engines/vllm-ascend/<ENGINE_VERSION>/<HARDWARE_FAMILY>/models/
# 可选: ascend-a2 / ascend-a3 / ascend910b-x86_64 (以镜像内实际目录为准)
HARDWARE_FAMILY=ascend-a2

# --- 端口配置 ---
ENGINE_PORT=17001
CONTROL_PORT=18001
HEALTH_PORT=19001
MONITOR_PROXY_PORT=19101
# License 状态查询(GET /license_status)复用 HEALTH_PORT,不独立占端口

# --- 服务命名后缀 (影响容器名) ---
SERVICE_SUFFIX=qwen

# --- vLLM 引擎参数 ---
QUANTIZATION=ascend
GPU_MEMORY_UTILIZATION=0.9
SHM_SIZE=16g
INPUT_LENGTH=16384
OUTPUT_LENGTH=16384
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=
KV_CACHE_DTYPE=auto
BLOCK_SIZE=128
DTYPE=auto
TRUST_REMOTE_CODE=true

# --- 设备挂载  ---
DEVICE_COUNT=2
XPU_VISIBLE_DEVICES=10,12

ENABLE_REASON_PROXY=true

# wings-accel 加速和安装开关
ENABLE_ACCEL=false

# --- SmartAccel: 投机解码 (smart_decoding) ---
# 开关: true/false
ENABLE_SPECULATIVE_DECODE=false
# 草稿模型路径(可选)，注释掉不传时走 no_model 方案，MTP/suffix/ngram 等。需要外部草稿模型的方法: eagle3/eagle/dflash/dspark(草稿形态)等
#SPECULATIVE_DECODE_MODEL_PATH=/data/models/draft-model


# --- SmartAccel: KV 稀疏 (smart_kv_sparse) ---
# 开关: true/false; 
ENABLE_SPARSE=false
#SPARSE_LEVEL 取值 performance_first/accuracy_first
#SPARSE_LEVEL=performance_first


# --- SmartAccel: KV 卸载
# 一级总开关: true/false(缺省按 false 兼容)
ENABLE_KV_OFFLOAD=false

# 二级内存卸载: true/false; SIZE 取值 "auto"(智能推荐) 或固定数值(单位 GB)
#ENABLE_KV_MEM_OFFLOAD=false
#KV_MEM_OFFLOAD_SIZE=auto
# 内存卸载容量智能估算(SIZE 取 auto 时)的依赖: 输入数值, 单位 MiB(如 65536=64GB)
#AVAILABLE_POD_MEM_SIZE=

# 二级磁盘卸载: true/false; PATH 为卸载目录; SIZE 为数值(单位 GB)
#ENABLE_KV_DISK_OFFLOAD=false
#KV_DISK_OFFLOAD_PATH=
#KV_DISK_OFFLOAD_SIZE=40

# 三级 QAT 压缩(Intel QAT 硬件专用, NPU 场景无此设备不传):
#ENABLE_KV_QAT=true/false; 
#KV_QAT_COMPRESS_LEVEL=
#KV_QAT_INSTANCE_NUM=

