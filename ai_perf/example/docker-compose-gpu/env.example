# --- 镜像配置 ---
IMAGE_ACCEL=fusionregistry:5000/wings-accel:26.0.0
# 必须是 -license 后缀 tag(含 License 门禁,由 build/build.sh --enable-license 产出)
IMAGE_CONTROL=fusionregistry:5000/wings-control:26.0.0-license
IMAGE_ENGINE=vllm/vllm-openai:v0.18.0
ENGINE=vllm
# 引擎版本: 选择 wings-infer-pro 配置资产树
# 注意: vllm 配置树无版本层(目录直接是硬件族 h100/h200/...), ENGINE_VERSION
# 不参与路径定位; 此处仅作元信息保留。
ENGINE_VERSION=v0.18.0

# --- 模型配置 ---
MODEL_NAME=Qwen3-0.6B
MODEL_PATH=/home/weight/Qwen3-0.6B

# --- 硬件族配置 ---
# 定位 config/engines/vllm/<ENGINE_VERSION>/<HARDWARE_FAMILY>/models/
# 可选: h100 / h200 / h20_141G / l20 / b200 ... (以镜像内实际目录为准;
# 带显存后缀如 h20_141G 用于单卡显存推导)
HARDWARE_FAMILY=h100

# --- 端口配置 ---
ENGINE_PORT=17001
CONTROL_PORT=18001
HEALTH_PORT=19001
MONITOR_PROXY_PORT=19101

# --- 服务命名后缀 (影响容器名) ---
SERVICE_SUFFIX=qwen

# --- vLLM 引擎参数 ---
QUANTIZATION=
GPU_MEMORY_UTILIZATION=0.9
SHM_SIZE=16g
INPUT_LENGTH=16384
OUTPUT_LENGTH=16384
MAX_NUM_SEQS=64
MAX_NUM_BATCHED_TOKENS=
KV_CACHE_DTYPE=auto
BLOCK_SIZE=128
DTYPE=auto
TRUST_REMOTE_CODE=true

# --- 设备挂载  ---
DEVICE_COUNT=1
XPU_VISIBLE_DEVICES=0

# --- 特性开关 ---
ENABLE_REASON_PROXY=true
ENABLE_SPECULATIVE_DECODE=true
ENABLE_ACCEL=false
ENABLE_SPARSE=false
